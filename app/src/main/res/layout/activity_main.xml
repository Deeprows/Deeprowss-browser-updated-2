<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F7F9"
    android:fitsSystemWindows="true">

    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#101116"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#101116">

                <GridLayout
                    android:id="@+id/categoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="18dp"
                    android:background="#101116">

                    <!-- HEADER: LOGO + LIVE LOCAL TIME -->

                    <LinearLayout
                        android:id="@+id/headerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/brandLogo"
                            android:layout_width="0dp"
                            android:layout_height="58dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="2dp"
                            android:src="@drawable/deeprowss_logo_img"
                            android:scaleType="fitStart"
                            android:adjustViewBounds="true"
                            android:contentDescription="Deeprowss Browser" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:gravity="end"
                            android:orientation="vertical">

                           <TextClock
    android:id="@+id/clockTime"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:format12Hour="h:mm:ss a"
    android:format24Hour="HH:mm:ss"
    android:includeFontPadding="false"
    android:textColor="#FFFFFF"
    android:textSize="15sp"
    android:textStyle="bold" />

<TextClock
    android:id="@+id/clockDate"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:format12Hour="EEE, d MMM"
    android:format24Hour="EEE, d MMM"
    android:includeFontPadding="false"
    android:textColor="#6B7280"
    android:textSize="10sp" />
                            
                        </LinearLayout>

                    </LinearLayout>

                    <!-- SEARCH BAR -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_home_card"
                        android:paddingStart="12dp"
                        android:paddingEnd="6dp">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="⌕"
                            android:textColor="#6B7280"
                            android:textSize="21sp" />

                        <EditText
                            android:id="@+id/addressBar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Search or enter website"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#B0AAB4"
                            android:textSize="14sp"
                            android:singleLine="true"
                            android:imeOptions="actionGo"
                            android:paddingStart="2dp"
                            android:paddingEnd="5dp" />

                        <ImageButton
                            android:id="@+id/goButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:background="@android:color/transparent"
                            android:src="@drawable/ic_send_modern"
                            android:tint="#FFFFFF"
                            android:elevation="3dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="Search"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/siteCategoriesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="8dp" />

                    <!-- LATEST NEWS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_home_section"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Latest News"
                            android:textColor="#202124"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:paddingStart="2dp"
                            android:paddingBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/newsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Loading latest news..."
                                android:textColor="#6B7280"
                                android:textSize="12sp"
                                android:padding="8dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/moreNewsButton"
                            android:tag="action_button"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            android:text="More News  →"
                            android:textColor="#1A73E8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_home_card"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- SPORT NEWS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:background="@drawable/bg_home_section"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sport News"
                            android:textColor="#202124"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:paddingStart="2dp"
                            android:paddingBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/sportNewsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Loading sport news..."
                                android:textColor="#6B7280"
                                android:textSize="12sp"
                                android:padding="8dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/moreSportNewsButton"
                            android:tag="action_button"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            android:text="More Sport News  →"
                            android:textColor="#1A73E8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_home_card"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- GOOGLE TRENDS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_home_section"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🔥 Google Trends"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/trendsLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="Worldwide"
                                android:textColor="#6B7280"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/trendsTranslateButton"
                                android:tag="accent"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="🌐 Translate"
                                android:textColor="#1A73E8"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:tag="muted"
                            android:text="What's trending right now"
                            android:textColor="#6B7280"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/trendsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/moreTrendsButton"
                            android:tag="action_button"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="View Google Trends"
                            android:textColor="#1A73E8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_home_card"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:tag="muted"
                            android:text="made with love by Taiwo Adesitimi"
                            android:textColor="#6B7280"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/appUpdateButton"
                            android:tag="action_button"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="App Update Enquiry"
                            android:textColor="#1A73E8"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_home_card"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </GridLayout>

            </FrameLayout>

        </ScrollView>

        <!-- WEBVIEW -->

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#101116" />

        <!-- SETTINGS -->

        <ScrollView
            android:id="@+id/settingsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#101116"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#202124"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Customize your Deeprows Browser"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="8dp"
                    android:background="#FFFFFF">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Data Saving"
                            android:textColor="#202124"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Reduce images and page data"
                            android:textColor="#6B7280"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <android.widget.Switch
                        android:id="@+id/dataSavingSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FF5C7C" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="8dp"
                    android:background="#FFFFFF">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ad Blocking"
                            android:textColor="#202124"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Block common advertising requests"
                            android:textColor="#6B7280"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <android.widget.Switch
                        android:id="@+id/adBlockingSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FF5C7C" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/vpnCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="VPN"
                                android:textColor="#202124"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Private, device-wide protection"
                                android:textColor="#6B7280"
                                android:textSize="10sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/vpnComingSoonBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="COMING SOON"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />

                        <Switch
                            android:id="@+id/vpnSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/vpnLocationButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:text="VPN Location  •  Coming soon"
                        android:textColor="#202124"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/vpnLocationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Available in a future update"
                        android:textColor="#5F6368"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/historyButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:text="🕘   History"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/bookmarksButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:text="★   Bookmarks"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/offlinePagesButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:text="↓   Offline Pages"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/clearCacheButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:text="♻   Clear Cache"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/findInPageButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="🔍   Find in Page"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/searchEngineButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="🔎   Search Engine"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/cookiesButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="🍪   Cookies &amp; Site Data"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/dnsButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="🛡️   DNS Configuration"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/notificationsButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="🔔   Notifications"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/aboutButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="ℹ️   About the Browser"
                    android:textColor="#202124"
                    android:textSize="14sp"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/themeButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="🎨  Theme"
                    android:textColor="#202124"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/downloadsButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="📥  Downloads"
                    android:textColor="#202124"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/shareButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="🔗  Share"
                    android:textColor="#202124"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/translateButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="🌐  Translate"
                    android:textColor="#202124"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/settingsBackButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="17dp"
                    android:gravity="center"
                    android:text="← Back to Browser"
                    android:textColor="#1A73E8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- BOTTOM NAVIGATION -->

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_back"
                android:tint="#E5E0E8"
                android:contentDescription="Back"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textColor="#6B7280"
                android:textSize="8sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/forwardButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_forward"
                android:tint="#E5E0E8"
                android:contentDescription="Forward"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forward"
                android:textColor="#6B7280"
                android:textSize="8sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/homeButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_home"
                android:tint="#1A73E8"
                android:contentDescription="Home"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#1A73E8"
                android:textSize="8sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/refreshPageButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_refresh"
                android:tint="#E5E0E8"
                android:contentDescription="Refresh"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refresh"
                android:textColor="#6B7280"
                android:textSize="8sp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/refreshButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_browser_tabs"
                    android:tint="#E5E0E8"
                    android:contentDescription="Open Pages"
                    android:padding="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tabs"
                    android:textColor="#6B7280"
                    android:textSize="8sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/pagesCount"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:layout_marginStart="17dp"
                android:layout_marginTop="-16dp"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="#FF1744" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/bookmarkButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_bookmark"
                android:tint="#E5E0E8"
                android:contentDescription="Bookmark"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="#6B7280"
                android:textSize="8sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_browser_menu"
                android:tint="#E5E0E8"
                android:contentDescription="Menu"
                android:padding="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu"
                android:textColor="#6B7280"
                android:textSize="8sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
